{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking the command against .claude/hooks/guard.py"
          }
        ]
      }
    ]
  }
}
