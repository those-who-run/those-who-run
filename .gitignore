.venv/
# Claude Code's worktrees and local settings stay out; the shared settings and the
# guard hook are tracked (#339).
.claude/*
!.claude/settings.json
!.claude/hooks/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
voices/*.onnx
voices/*.onnx.json
/data/
*.wav
*.jsonl
*.jsonl.gz
.env
!tests/fixtures/*.jsonl.gz
.preview/
web/node_modules/
web/test-results/
web/playwright-report/
